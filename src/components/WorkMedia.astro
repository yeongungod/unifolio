---
// 작품 스틸 하나. 유튜브가 있으면 누를 때만 iframe으로 바꾼다(페이지 로드 시 유튜브 스크립트 0).
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { imageMetadata } from 'astro/assets/utils';
import type { Featured } from '../data/featured';
import ResponsiveImage from './ResponsiveImage.astro';
interface Props { item: Featured; sizes: string; frame?: 'natural' | 'wide'; priority?: boolean }
const { item, sizes, frame = 'wide', priority = false } = Astro.props;
const src = item.image ?? `https://i.ytimg.com/vi/${item.youtube}/hqdefault.jpg`;
// 원본 비율을 빌드 때 읽어 width/height로 자리를 잡는다(CLS 0). 유튜브 썸네일은 480×360 고정.
const size = item.image ? await imageMetadata(readFileSync(join(process.cwd(), 'public', item.image))) : { width: 480, height: 360 };
const image = { src, alt: '', width: size?.width ?? 1280, height: size?.height ?? 720, sizes, loading: priority ? 'eager' as const : 'lazy' as const, fetchpriority: priority ? 'high' as const : undefined };
---
{item.youtube ? (
  <button class:list={['media', 'yt', frame]} data-id={item.youtube} aria-label={`${item.title} 재생`}>
    <ResponsiveImage {...image} />
    <span class="chip" aria-hidden="true"><svg viewBox="0 0 10 12" width="8" height="10"><path d="M0 0L10 6L0 12Z" fill="currentColor" /></svg>재생</span>
  </button>
) : item.url ? (
  <a class:list={['media', frame]} href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`${item.title} 영상 보기`}>
    <ResponsiveImage {...image} />
    <span class="chip" aria-hidden="true">영상</span>
  </a>
) : (
  <div class:list={['media', frame]}><ResponsiveImage {...image} /></div>
)}

<style>
  .media { position: relative; display: block; width: 100%; padding: 0; border: 0; border-radius: var(--radius-none); background: var(--ink-2); overflow: hidden; }
  .media.wide { aspect-ratio: 16 / 9; }
  .media :global(picture) { display: block; width: 100%; height: 100%; }
  .media :global(img) { width: 100%; height: auto; }
  .media.wide :global(img) { height: 100%; object-fit: cover; }
  .media :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  /* 재생 표시는 오른쪽 위 작은 칩: 썸네일 아래쪽에 박힌 제목 글자를 가리지 않는다 */
  .chip { position: absolute; top: var(--space-2); right: var(--space-2); display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); background: var(--ink); color: var(--paper); font-size: var(--type-web-caption-size); font-weight: 600; line-height: 1; transition: background-color var(--hover), color var(--hover); }
  .media:hover .chip, .media:focus-visible .chip { background: var(--paper); color: var(--ink); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('button.yt').forEach((b) => {
    b.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.id}?autoplay=1&rel=0`;
      f.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      f.allowFullscreen = true;
      f.title = b.getAttribute('aria-label') ?? '';
      const div = document.createElement('div');
      div.className = 'media wide';
      for (const a of b.attributes) if (a.name.startsWith('data-astro-cid')) div.setAttribute(a.name, '');
      div.appendChild(f);
      // 작은 썸네일 줄에서 누르면 그 줄 아래로 넓혀 재생한다
      b.closest('[data-player]')?.classList.add('is-playing');
      b.replaceWith(div);
      f.focus();
    }, { once: true });
  });
</script>

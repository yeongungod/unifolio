---
import { clients } from '../data/clients';
import ResponsiveImage from './ResponsiveImage.astro';
import images from '../data/optimized-images.json';
const maskSource = (file: string) => {
  const original = `/images/clients/${file}`;
  const variants = images[original as keyof typeof images];
  return variants?.find(v => v.width === 360)?.src ?? original;
};
---
<section id="clients" class="band animated" aria-labelledby="clients-title">
  <div class="wrap">
    <p id="clients-title" class="t-small muted">함께한 곳</p><!-- 띠의 작은 이름표: 제목 위계(h2)에서 뺀다 -->
  </div>
  <div class="clients-window" tabindex="0" aria-label="참여 브랜드 로고. 키보드로 선택하면 이동이 멈춥니다.">
    <div id="clients-track" style={`--duration: ${clients.length * 5}s`}>
      {[false, true].map((duplicate) => (
        <ul class="clients-list" aria-label={duplicate ? undefined : '참여 브랜드·기관'} aria-hidden={duplicate ? 'true' : undefined}>
          {clients.map((client, index) => (
            <li>
              <span class:list={['client-logo', { 'cover-logo': client.cover }]} style={`--s: ${client.scale ?? 1}`}>
              <ResponsiveImage src={`/images/clients/${client.file}`} alt={duplicate ? '' : client.name} class={[client.compact && 'compact', client.cover && 'cover', client.small && 'small'].filter(Boolean).join(' ')} width={180} height={80} sizes={`(max-width: 600px) ${Math.ceil(148 * (client.scale ?? 1))}px, ${Math.ceil(180 * (client.scale ?? 1))}px`} />
              {client.lightText && (
                <svg class="light-text" viewBox={`0 0 ${client.lightText.width} ${client.lightText.height}`} aria-hidden="true">
                  <defs>
                    <mask id={`client-text-${duplicate}-${index}`} style="mask-type: alpha" maskUnits="userSpaceOnUse" x="0" y="0" width={client.lightText.width} height={client.lightText.height}>
                      <image href={maskSource(client.file)} width={client.lightText.width} height={client.lightText.height} />
                    </mask>
                  </defs>
                  <rect x={client.lightText.x} y={client.lightText.y} width={client.lightText.width - client.lightText.x} height={client.lightText.height - client.lightText.y} fill="currentColor" mask={`url(#client-text-${duplicate}-${index})`} />
                </svg>
              )}
              </span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>
<style>
  /* 첫 화면 바로 아래 구분 띠(10-16 안 A): 작은 제목 + 한 줄 로고 흐름 */
  #clients { padding-block: var(--space-3); border-block: 1px solid var(--line); background: var(--ink); color: var(--paper); overflow: hidden; }
  @media (min-width: 900px) {
    #clients { box-sizing: border-box; height: var(--band-h); }
    #clients .clients-list li { height: 88px; padding-block: var(--space-1); }
  }
  @media (max-width: 899.98px) { #clients { margin-top: var(--space-14); } }
  .clients-window { margin: var(--space-2) auto 0; max-width: 1600px; }
  .clients-window:focus-visible { outline: 2px solid var(--paper); outline-offset: -2px; }
  .clients-list { display: flex; flex-wrap: wrap; justify-content: center; padding: 0; margin: 0; list-style: none; }
  .clients-list[aria-hidden] { display: none; }
  .clients-list li { flex: 0 0 228px; height: 104px; display: flex; align-items: center; justify-content: center; padding: 12px 24px; background: var(--ink); }
  .client-logo { position: relative; width: 180px; height: 80px; display: flex; align-items: center; justify-content: center; }
  .client-logo > :global(picture) { width: 180px; height: 80px; display: flex; align-items: center; justify-content: center; }
  .clients-list :global(img) { width: 180px; height: 80px; object-fit: contain; }
  /* 배율은 자식에 건다. 부모에 transform을 걸면 ONSIDE의 mix-blend-mode가 깨진다 */
  .client-logo > :global(picture), .client-logo > .light-text { transform: scale(var(--s, 1)); }
  .light-text { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .clients-list :global(img.compact) { width: 100px; }
  .clients-list :global(img.small) { width: 140px; }
  .client-logo.cover-logo > :global(picture) { mix-blend-mode: screen; }
  .clients-list :global(img.cover) { object-fit: cover; height: 64px; }
  .animated .clients-window { overflow: hidden; }
  .animated #clients-track { display: flex; width: max-content; animation: clients-flow var(--duration) linear infinite; }
  .animated .clients-list { display: flex; flex-wrap: nowrap; flex-shrink: 0; }
  .clients-window:focus-visible #clients-track { animation-play-state: paused; }
  @keyframes clients-flow { to { transform: translateX(-50%); } }
  @media (max-width: 600px) {
    .clients-list li { flex-basis: 180px; padding-inline: 16px; }
    .client-logo > :global(picture) { width: 148px; height: 64px; }
    .clients-list :global(img) { width: 148px; height: 64px; }
    .client-logo { width: 148px; height: 64px; }
  }
  @media (prefers-reduced-motion: reduce), print {
    .animated #clients-track { display: block; width: auto; animation: none; transform: none; }
    .animated .clients-list { display: flex; flex-wrap: wrap; }
    .animated .clients-list[aria-hidden] { display: none; }
  }
  @media (prefers-reduced-motion: reduce) and (max-width: 600px) {
    .clients-list li { flex-basis: 50%; }
    .clients-list :global(img) { max-width: 100%; }
  }
</style>

---
import { site } from '../data/site';
---
<section id="contact">
  <div class="wrap split">
    <div class="head">
      <p class="label">Contact</p>
      <h2>문의</h2>
    </div>
    <div class="body">
      <p class="ask">작업 범위와 일정을 알려주시면 견적을 드립니다.</p>
      <a class="btn accent mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>
<style>
  /* 10-19 사용자 「문의 박스 너무 커」: 보통 크기 주요 버튼(17px, 기본 안쪽 여백) */
  .ask { font-size: 18px; font-weight: var(--type-web-lead-weight); line-height: var(--type-web-lead-leading); letter-spacing: var(--type-web-lead-tracking); color: var(--muted); }
  .mail { margin-top: 20px; font-size: 17px; overflow-wrap: anywhere; }
</style>

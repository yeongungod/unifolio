---
// 마지막 「문의」(v5): 왼쪽 축 = 장 제목, 오른쪽 = 상호 → 메일 크게 → 한 줄 안내 → 버튼 하나. 메일이면 충분(사용자 10-18)
import { site } from '../data/site';
---
<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="wrap split">
    <h2 id="contact-title">문의</h2>
    <div class="card">
      <p class="t-statement" translate="no">{site.name}</p>
      <p class="direct"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p class="t-small muted">작업 범위와 일정을 알려주시면 견적을 드립니다.</p>
      <a class="btn primary" href={`mailto:${site.email}`}>메일 보내기</a>
    </div>
  </div>
</section>
<style>
  .card { display: grid; justify-items: start; }
  .direct { margin-top: var(--space-4); font-size: var(--type-web-headline-size); font-weight: var(--type-web-credit-value-weight); line-height: var(--type-web-headline-leading); letter-spacing: var(--type-web-headline-tracking); }
  .direct a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 6px; overflow-wrap: anywhere; transition: text-decoration-color var(--hover); }
  .direct a:hover { text-decoration-color: var(--paper); }
  .muted { margin-top: var(--space-2); }
  .btn { margin-top: var(--space-8); }
</style>

---
// 마지막 「제작사」 블록(End Card): 상호 → 연락처 크게 → 기관용 정보 크레딧 축 → 버튼
import { site } from '../data/site';
const [independentProduction, videoProduction] = site.licenses.split(' · ').map((l) => l.split(' 신고 '));
---
<section id="contact" class="section end-card" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title" class="t-statement"><span class="visually-hidden">문의 · </span>{site.name}</h2>
    <p class="direct">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.phoneHref}>{site.phone}</a>
    </p>
    <p class="t-small muted note">작업 범위와 일정을 알려주시면 견적을 드립니다.</p>
    <dl class="credits info">
      <div class="credit-row"><dt>대표</dt><dd>{site.owner}</dd></div>
      <div class="credit-row"><dt>사업자등록번호</dt><dd>{site.bizNo}</dd></div>
      <div class="credit-row"><dt>{independentProduction[0]}</dt><dd>신고 {independentProduction[1]}</dd></div>
      <div class="credit-row"><dt>{videoProduction[0]}</dt><dd>신고 {videoProduction[1]}</dd></div>
      <div class="credit-row"><dt>나라장터</dt><dd>등록 업체</dd></div>
      <div class="credit-row"><dt>과세 유형</dt><dd>{site.taxType}</dd></div>
      <div class="credit-row"><dt>소재지</dt><dd>{site.region}</dd></div>
    </dl>
    <div class="actions">
      <a class="btn primary" href={`mailto:${site.email}`}>메일 보내기</a>
      <a class="btn" href={site.phoneHref}>전화하기</a>
    </div>
  </div>
</section>
<style>
  .end-card { text-align: center; }
  .direct { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 var(--space-8); margin-top: var(--space-6); font-size: var(--type-web-headline-size); font-weight: var(--type-web-credit-value-weight); line-height: var(--type-web-headline-leading); letter-spacing: var(--type-web-headline-tracking); }
  .direct a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 6px; transition: text-decoration-color var(--hover); }
  .direct a:hover { text-decoration-color: var(--paper); }
  .note { margin-top: var(--space-3); }
  .info { margin-top: var(--space-12); text-align: left; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-12); }
  @media (max-width: 599.98px) {
    .end-card, .direct, .actions { text-align: left; justify-content: flex-start; }
    .direct { flex-direction: column; }
    .info, .actions { margin-top: var(--space-8); }
  }
</style>

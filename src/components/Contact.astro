---
import { site } from '../data/site';
const [independentProduction, videoProduction] = site.licenses.split(' · ');
---
<section id="contact">
  <div class="wrap">
    <p class="label">Contact</p>
    <h2>문의</h2>
    <p class="muted" style="margin-top:12px">작업 범위와 일정을 알려주시면 견적을 드립니다.</p>
    <table class="business-info">
      <caption>{site.name} 사업자 정보</caption>
      <tbody>
        <tr><th scope="row">상호</th><td>{site.name}</td></tr>
        <tr><th scope="row">대표</th><td>{site.owner}</td></tr>
        <tr><th scope="row">사업자등록번호</th><td>{site.bizNo}</td></tr>
        <tr><th scope="row">방송영상독립제작사</th><td>{independentProduction.split(' 신고 ')[1]}</td></tr>
        <tr><th scope="row">비디오물제작업</th><td>{videoProduction.split(' 신고 ')[1]}</td></tr>
        <tr><th scope="row">나라장터</th><td>나라장터 등록 업체</td></tr>
        <tr><th scope="row">과세유형</th><td>{site.processNote.split('.')[0]}.</td></tr>
        <tr><th scope="row">메일</th><td>{<a href={`mailto:${site.email}`}>{site.email}</a>}</td></tr>
        <tr><th scope="row">전화</th><td>{<a href={site.phoneHref}>{site.phone}</a>}</td></tr>
      </tbody>
    </table>
    <div class="links">
      <a class="btn accent" href={`mailto:${site.email}`}>{site.email}</a>
    </div>

  </div>
</section>
<style>
  .links { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .business-info { width: 100%; border-collapse: collapse; margin-top: 24px; font-size: 16px; }
  caption { text-align: left; font-weight: 600; margin-bottom: 12px; }
  th, td { border-bottom: 1px solid var(--line); padding: 12px 0; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
  th { width: 32%; padding-right: 16px; font-weight: 600; }
  td a { display: inline-flex; min-height: 44px; align-items: center; text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; max-width: 100%; }
  @media (max-width: 600px) { th { width: 40%; font-size: 14px; } }
</style>

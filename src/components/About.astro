---
import { site } from '../data/site';
import rows from '../data/archive.json';
import { featured } from '../data/featured';
import { groupedRecognition } from '../lib/recognition.mjs';
const a = site.about;
const groups = groupedRecognition(rows, a.awards, site.screenings, featured);
const toolLogos: Record<string, { file: string; url: string }> = {
  'Premiere Pro': { file: 'premiere-pro.svg', url: 'https://www.adobe.com/products/premiere.html' },
  'Pro Tools': { file: 'pro-tools.png', url: 'https://www.avid.com/pro-tools' },
  'After Effects': { file: 'after-effects.svg', url: 'https://www.adobe.com/products/aftereffects.html' },
  'Photoshop': { file: 'photoshop.svg', url: 'https://www.adobe.com/products/photoshop.html' },
  'Cubase': { file: 'cubase.png', url: 'https://www.steinberg.net/cubase/' },
  'Ableton Live': { file: 'ableton-live.png', url: 'https://www.ableton.com/live/' },
  'iZotope': { file: 'izotope.svg', url: 'https://www.izotope.com/' },
  'Waves': { file: 'waves.png', url: 'https://www.waves.com/plugins' },
  'UAD': { file: 'uad.png', url: 'https://www.uaudio.com/' },
};
const tools = a.tools.map((name) => ({ name, ...toolLogos[name] }));
const intro = a.intro.split('\n');
const shown = 4; // 처음에 보이는 작품 수: 왼쪽 블록(이름·소개·학력·툴) 높이와 맞춘다. 나머지는 「이력 더 보기」
---
<section id="studio">
  <div class="wrap">
    {/* 「엔드 크레딧」(10-19 사용자 선택): 왼쪽 4열 = 이름·소개·학력/자격·툴 아이콘 한 줄, 오른쪽 8열 = 작품 · 연도 | 이력 두 칸 크레딧 */}
    <div class="split">
      <div class="head">
        <p class="label">Studio</p>
        <h2>{site.name}</h2>
        <p class="lead">{intro.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
        <dl class="facts">
          <div><dt>학력</dt><dd>{a.edu}</dd></div>
          <div><dt>자격</dt><dd>{a.certs.map((c) => <span class="ln">{c}</span>)}</dd></div>
        </dl>
        <ul class="icons" aria-label="사용 툴">{tools.map((t) => <li><a href={t.url} target="_blank" rel="noopener noreferrer" title={t.name} aria-label={t.name}><img src={`/images/tools/${t.file}`} alt="" width="28" height="28" loading="lazy" /></a></li>)}</ul>
      </div>
      <div class="body">
        <h3 class="cap">이력</h3>
        <div class="credits">
          {groups.map((g, i) => (
            <div class:list={['cr', { late: i >= shown }]}>
              <p class="k">{g.work ? <strong>{g.work}</strong> : <strong>공모전</strong>}<span>{g.year}</span></p>
              <ul class="v">{g.records.map((r) => <li>{r.source ? <a href={r.source} target="_blank" rel="noopener noreferrer">{r.text}</a> : r.text}</li>)}</ul>
            </div>
          ))}
        </div>
        {groups.length > shown && <button type="button" class="open" aria-expanded="false">이력 더 보기</button>}
      </div>
    </div>
  </div>
</section>
<style>
  .lead { margin-top: 18px; font-size: 17px; font-weight: var(--type-web-lead-weight); line-height: var(--type-web-lead-leading); letter-spacing: var(--type-web-lead-tracking); max-width: 38em; }
  @media (max-width: 600px) { .lead br { display: none; } } /* 좁은 화면은 줄을 강제로 끊지 않고 흐르게 */
  .facts { margin: 28px 0 0; font-size: var(--type-web-small-size); line-height: var(--type-web-small-leading); letter-spacing: var(--type-web-small-tracking); }
  .facts div { display: grid; grid-template-columns: 3em minmax(0, 1fr); gap: 12px; padding: 8px 0; border-top: 1px solid var(--line); }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }
  .facts .ln { display: block; }
  .icons { list-style: none; display: flex; flex-wrap: wrap; gap: 4px; padding: 0; margin: 20px 0 0; }
  .icons a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius-sm); opacity: 0.85; }
  .icons a:hover { opacity: 1; background: var(--ink-2); }
  .icons img { width: 28px; height: 28px; object-fit: contain; }
  .cap { font-size: var(--type-web-label-size); font-weight: var(--type-web-label-weight); letter-spacing: var(--type-web-label-tracking); color: var(--muted); }
  .credits { margin-top: 12px; }
  .cr { display: grid; gap: 4px 32px; padding: 16px 0; border-top: 1px solid var(--line); font-size: var(--type-web-small-size); line-height: var(--type-web-small-leading); letter-spacing: var(--type-web-small-tracking); }
  .k { display: flex; justify-content: space-between; gap: 16px; }
  .k span { color: var(--muted); font-variant-numeric: tabular-nums; }
  .v { list-style: none; padding: 0; margin: 0; color: var(--muted); }
  .v li + li { margin-top: 2px; }
  .v a { text-decoration: underline; text-underline-offset: 3px; }
  .cr.late { display: none; }
  .credits.all .cr.late { display: grid; }
  .open { display: block; width: 100%; text-align: left; margin-top: 4px; padding: 12px 0; background: none; border: 0; border-top: 1px solid var(--line); color: var(--paper); font-size: 14px; cursor: pointer; }
  @media (min-width: 1024px) { .cr { grid-template-columns: minmax(0, 3fr) minmax(0, 5fr); } }
</style>
<script>
  // 「이력 더 보기」: 숨긴 크레딧 줄을 펼치고 접는다
  document.querySelectorAll<HTMLButtonElement>('#studio .open').forEach((b) => {
    const label = b.textContent;
    b.addEventListener('click', () => {
      const open = b.previousElementSibling!.classList.toggle('all');
      b.setAttribute('aria-expanded', String(open));
      b.textContent = open ? '이력 접기' : label;
    });
  });
</script>

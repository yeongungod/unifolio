---
import { site } from '../data/site';
import rows from '../data/archive.json';
import { mainRecognition } from '../lib/recognition.mjs';
const a = site.about;
const { events, releases } = mainRecognition(rows, a.awards, site.screenings);
const toolLogos: Record<string, { file: string; url: string }> = {
  'Premiere Pro': { file: 'premiere-pro.svg', url: 'https://www.adobe.com/products/premiere.html' },
  'Pro Tools': { file: 'pro-tools.png', url: 'https://www.avid.com/pro-tools' },
  'After Effects': { file: 'after-effects.svg', url: 'https://www.adobe.com/products/aftereffects.html' },
  'Photoshop': { file: 'photoshop.svg', url: 'https://www.adobe.com/products/photoshop.html' },
  'Cubase': { file: 'cubase.png', url: 'https://www.steinberg.net/cubase/' },
  'Ableton Live': { file: 'ableton-live.png', url: 'https://www.ableton.com/live/' },
  'iZotope': { file: 'izotope.svg', url: 'https://www.izotope.com/' },
  'Waves': { file: 'waves.png', url: 'https://www.waves.com/plugins' },
  'UAD': { file: 'uad.png', url: 'https://www.uaudio.com/' },
};
---
<section id="studio">
  <div class="wrap">
    <p class="label">Studio</p>
    <h2>{site.name}</h2>
    <p class="intro">{a.intro}</p>
    <div class="cols">
      <div>
        <h3>수상 · 상영 · 선정</h3>
        <p class="recognition-note muted">개업 전 대표 참여작의 기록을 포함합니다.</p>
        <ul class="awards">
          {events.slice(0, 8).map((w) => <li><span class="date muted">{w.year || '연도 미표기'}</span><div class="record">{w.work && <strong>「{w.work}」</strong>}<p>{w.source ? <a href={w.source} target="_blank" rel="noopener noreferrer">{w.text}</a> : w.text}</p></div></li>)}
        </ul>
        {events.length > 8 && <details class="more-records"><summary>수상 · 상영 기록 더 보기</summary><ul class="awards">{events.slice(8).map((w) => <li><span class="date muted">{w.year || '연도 미표기'}</span><div class="record">{w.work && <strong>「{w.work}」</strong>}<p>{w.source ? <a href={w.source} target="_blank" rel="noopener noreferrer">{w.text}</a> : w.text}</p></div></li>)}</ul></details>}
        {releases.length > 0 && <details class="release-records"><summary>배급 · 공개 정보</summary><ul class="release-list">{releases.map((w) => <li><strong>「{w.work}」</strong><span>{w.text}</span></li>)}</ul></details>}
      </div>
      <div>
        <h3>학력 · 자격</h3>
        <p>{a.edu}</p>
        <ul class="plain">{a.certs.map((c) => <li>{c}</li>)}</ul>
        <h3 style="margin-top:24px">사용 툴</h3>
        <ul class="tools">{a.tools.map((tool) => (
          <li><a href={toolLogos[tool].url} target="_blank" rel="noopener noreferrer">
            <img src={`/images/tools/${toolLogos[tool].file}`} alt="" width="28" height="28" loading="lazy" />
            <span>{tool}</span>
          </a></li>
        ))}</ul>
      </div>
    </div>
  </div>
</section>
<style>
  .intro { margin-top: 18px; max-width: 60ch; font-size: 17px; }
  .cols { display: grid; gap: 40px; grid-template-columns: 1.4fr 1fr; margin-top: 40px; }
  .awards, .plain { list-style: none; padding: 0; margin: 12px 0 0; }
  .recognition-note { margin-top: 8px; font-size: 12px; }
  .awards li { display: grid; grid-template-columns: 76px minmax(0,1fr); gap: 16px; padding: 16px 0; border-top: 1px solid var(--line); font-size: 14px; }
  .date { font-variant-numeric: tabular-nums; font-size: 13px; }
  .record { min-width: 0; word-break: keep-all; overflow-wrap: anywhere; }
  .record strong { display: block; margin-bottom: 5px; }
  .record p { color: var(--muted); }
  .record a { text-decoration: underline; text-underline-offset: 3px; }
  .release-records, .more-records { border-top: 1px solid var(--line); margin-top: 16px; padding-top: 16px; font-size: 14px; }
  .release-records summary, .more-records summary { cursor: pointer; padding: 8px 0; }
  .release-list { list-style: none; padding: 0; }
  .release-list li { display: grid; gap: 4px; margin-top: 14px; }
  .release-list span { color: var(--muted); }
  .plain li { font-size: 14px; color: var(--muted); }
  .tools { list-style: none; padding: 0; margin: 12px 0 0; font-size: 14px; color: var(--muted); }
  .tools li + li { margin-top: 4px; }
  .tools a { display: flex; align-items: center; gap: 12px; min-height: 40px; width: fit-content; color: inherit; text-decoration: none; }
  .tools a:hover { color: var(--paper); }
  .tools img { width: 28px; height: 28px; object-fit: contain; flex: none; }
  @media (max-width: 700px) { .cols { grid-template-columns: 1fr; gap: 28px; } .awards li { grid-template-columns: 66px minmax(0,1fr); gap: 12px; } }
</style>

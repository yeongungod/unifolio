---
import { site } from '../data/site';
---
<section id="services">
  <div class="wrap split">
    <div class="head">
      <p class="label">Services</p>
      <h2>{site.servicesTitle}</h2>
    </div>
    <ul class="services body">
      {site.services.map((s) => (
        <li><h3>{s.title}</h3><p class="muted">{s.desc.split('\n').map((l, i) => <>{i > 0 && <br />}{l}</>)}</p></li>
      ))}
    </ul>
  </div>
</section>
<style>
  /* 2×2(회사소개서와 같은 배치). 오른쪽 8열 안이라 1280에서도 칸이 380px 넘는다. 4열은 칸이 좁아 설명이 3줄로 접혔다(10-07) */
  .services { list-style: none; padding: 0; margin: 0; display: grid; gap: 28px 32px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .services li { border-top: 1px solid var(--line); padding-top: 14px; }
  .services p { margin-top: 6px; font-size: var(--type-web-small-size); line-height: var(--type-web-small-leading); letter-spacing: var(--type-web-small-tracking); }
  @media (max-width: 600px) { .services { grid-template-columns: 1fr; gap: 20px; } }
</style>

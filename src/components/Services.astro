---
// 작업 범위(v5): 왼쪽 축 = 장 제목, 오른쪽 = 하는 일 4개를 2×2(600px 미만 1열), 칸마다 위 가는 선
import { site } from '../data/site';
---
<section id="services" class="section" aria-labelledby="services-title">
  <div class="wrap split">
    <h2 id="services-title">{site.servicesTitle}</h2>
    <div>
      <ul class="services">
        {site.services.map((s) => (
          <li class="service rise-on-view">
            <h3 class="t-work">{s.title.split(' ').map((w) => <><span class="nb">{w}</span> </>)}</h3>
            <p class="desc">{s.desc}</p>
          </li>
        ))}
      </ul>
      <p class="process t-small muted">{site.process.join(' → ')}</p>
    </div>
  </div>
</section>
<style>
  .services { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-12) var(--space-8); }
  .service { display: grid; align-content: start; gap: var(--space-2); padding-top: var(--space-6); border-top: 1px solid var(--line); }
  .nb { white-space: nowrap; } /* 「믹싱·사운드디자인」이 가운뎃점에서 갈려 줄 머리에 「·」가 오지 않게 띄어쓰기에서만 줄을 바꾼다 */
  .desc { white-space: pre-line; } /* site.ts desc의 \n = 줄바꿈 */
  .process { margin-top: var(--space-12); }
  @media (max-width: 599.98px) {
    .services { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
    .service { padding-top: var(--space-4); }
    .process { margin-top: var(--space-8); }
  }
</style>

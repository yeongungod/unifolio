---
import { site } from '../data/site';
---
<section id="services" class="section" aria-labelledby="services-title">
  <div class="wrap">
    <h2 id="services-title" class="section-title">{site.servicesTitle}</h2>
    <dl class="credits services">
      {site.services.map((s) => (
        <div class="credit-row service">
          <dt>{s.label}</dt>
          <dd><span class="name t-work">{s.title}</span><span class="desc">{s.desc}</span></dd>
        </div>
      ))}
    </dl>
    <div class="process">
      <p class="t-credit">{site.process.join(' → ')}</p>
      <p class="t-small muted">{site.processNote.split('. ')[0].replace(/\.?$/, '.')}</p>
    </div>
  </div>
</section>
<style>
  .services { margin-top: var(--space-12); border-top: 1px solid var(--line); }
  .service { padding-top: var(--space-6); padding-bottom: var(--space-6); border-bottom: 1px solid var(--line); }
  .service dt { padding-top: calc((var(--type-web-work-size) - var(--type-web-small-size)) / 2); }
  .service dd { display: grid; gap: var(--space-2); }
  .desc { font-size: var(--type-web-body-size); font-weight: var(--type-web-body-weight); line-height: var(--type-web-body-leading); white-space: pre-line; }
  .process { display: grid; justify-items: center; gap: var(--space-2); margin-top: var(--space-12); text-align: center; }
  @media (max-width: 599.98px) {
    .services { margin-top: var(--space-8); }
    .service { padding-top: var(--space-4); padding-bottom: var(--space-4); }
    /* 모바일에선 범주가 제목 위 작은 라벨(eyebrow)처럼 보여 화면에서만 숨긴다(화면낭독기엔 남김) */
    .service dt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .process { margin-top: var(--space-8); }
  }
</style>

---
import { featured, type Featured } from '../data/featured';
import rows from '../data/archive.json';
import { site } from '../data/site';
import { groupedRecognition } from '../lib/recognition.mjs';
interface Props { item: Featured; compact?: boolean }
const { item, compact = false } = Astro.props;
const thumb = item.image ?? (item.youtube ? `https://i.ytimg.com/vi/${item.youtube}/hqdefault.jpg` : undefined);
const records = groupedRecognition(rows, site.about.awards, site.screenings, featured).find(group => group.workId === item.slug)?.records ?? [];
const events = records.filter(record => record.kind === 'event');
const releases = records.filter(record => record.kind !== 'event');
---
<article class:list={['card', { compact }]}>
  {item.youtube ? (
    <button class="media yt" data-id={item.youtube} aria-label={`${item.title} 재생`}>
      <img src={thumb} alt="" loading="lazy" width="480" height="360" />
      <span class="play" aria-hidden="true">▶</span>
    </button>
  ) : item.url ? (
    <a class="media" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`${item.title} 영상 보기`}><img src={thumb} alt="" loading="lazy" width="1280" height="720" /></a>
  ) : (
    <div class="media"><img src={thumb} alt="" loading="lazy" width="1280" height="720" /></div>
  )}
  <div class="body">
    <p class="label">{item.client}</p>
    <h3>{item.title}</h3>
    <p class="role">{item.role}</p>
    {!compact && (records.length ? <div class="note muted">
      {events.slice(0, 2).map(record => <p>{record.text}</p>)}
      {releases.map(record => <p>{record.text}</p>)}
      {events.length > 2 && <details><summary>이력 더 보기</summary>{events.slice(2).map(record => <p>{record.text}</p>)}</details>}
    </div> : item.note && <p class="note muted">{item.note}</p>)}
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; gap: 12px; }
  .media { position: relative; aspect-ratio: 16/9; overflow: hidden; border-radius: 6px; background: var(--ink-2); padding: 0; border: 0; width: 100%; }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .play { position: absolute; inset: 0; display: grid; place-items: center; color: var(--paper); font-size: 28px; background: var(--video-shade); transition: background .15s; }
  .yt:hover .play { background: var(--video-hover); }
  .media :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .role { font-size: 14px; color: var(--accent); margin-top: 4px; }
  .note { font-size: 14px; margin-top: 6px; }
  .role, .note { word-break: keep-all; overflow-wrap: anywhere; }
  .note p + p { margin-top: 4px; }
  .note details { margin-top: 6px; }
  .note summary { cursor: pointer; width: fit-content; }
  .note details p { margin-top: 4px; }
  .compact .note { display: none; }
</style>

<script>
  // 클릭한 카드만 iframe으로 교체 — 페이지 로드 시 유튜브 스크립트 0
  document.querySelectorAll<HTMLButtonElement>('.yt').forEach((b) => {
    b.addEventListener('click', () => {
      const id = b.dataset.id;
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      f.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      f.allowFullscreen = true;
      f.title = b.getAttribute('aria-label') ?? '';
      const div = document.createElement('div');
      div.className = 'media';
      for (const a of b.attributes) if (a.name.startsWith('data-astro-cid')) div.setAttribute(a.name, '');
      div.appendChild(f);
      b.replaceWith(div);
      f.focus();
    }, { once: true });
  });
</script>

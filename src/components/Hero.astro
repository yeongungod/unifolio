---
import { site } from '../data/site';
---
<section class="hero" id="top">
  <div class="wrap">
    <h1>{site.hero.title.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h1>
    <p class="sub">{site.hero.sub}</p>
  </div>
</section>
<style>
  .hero { border-top: 0; padding: 64px 0 48px; }
  /* 공개본 배치 유지: SUITE 기준 18ch·46ch를 em으로 고정(Pretendard 숫자 폭이 좁아 ch가 줄어든다) */
  h1 { max-width: 13em; }
  .sub { margin-top: 18px; font-size: 18px; font-weight: var(--type-web-lead-weight); line-height: 1.6; letter-spacing: var(--type-web-lead-tracking); color: var(--muted); max-width: 32.5em; }
  @media (max-width: 600px) { .hero { padding: 44px 0 32px; } .sub { font-size: 16px; } }
</style>

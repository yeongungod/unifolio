---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title={`페이지를 찾을 수 없습니다 · ${site.name}`} description="요청하신 페이지를 찾을 수 없습니다. 우니스튜디오 홈이나 전체 작업에서 필요한 정보를 확인해 주세요." noindex>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="wrap">
      <h1 id="not-found-title" class="t-statement">장면이 비었습니다</h1>
      <p class="t-lead message">주소가 바뀌었거나 없는 페이지입니다. 홈이나 전체 작업에서 찾아 주세요.</p>
      <div class="links"><a class="btn primary" href="/">홈으로</a><a class="btn" href="/work">전체 작업 보기</a></div>
    </div>
  </section>
</Base>
<style>
  .not-found { padding-top: var(--section); padding-bottom: var(--section); text-align: center; }
  .message { max-width: var(--space-web-read); margin: var(--space-6) auto 0; }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-12); }
</style>

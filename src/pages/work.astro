---
import Base from '../layouts/Base.astro';
import ArchiveTable from '../components/ArchiveTable.astro';
import { site } from '../data/site';
---
<Base title={`전체 작업 · ${site.nameEn}`} description="2019년부터 지금까지의 영상·사운드·라이브 작업 목록.">
  <section class="page">
    <div class="wrap">
      <p class="label">Archive</p>
      <h1 class="page-title">전체 작업</h1>
      <p class="muted sub">2019년부터 지금까지 이어온 작업들입니다.</p>
      <ArchiveTable />
    </div>
  </section>
</Base>
<style>
  .page { border-top: 0; }
  .sub { margin-top: 10px; }
</style>
